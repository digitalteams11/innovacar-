# Innovacar Desktop - Environment Variables
# Copy this file to .env and fill in your values

# API Base URL. Under Electron's file:// origin there is no usable browser
# hostname to guess from, so this should normally be set explicitly:
# - same machine as the backend: http://localhost:8082/api
# - production backend: https://api.innovacar.app/api
# If unset, the app falls back to localhost:8082/api in dev.
# This can also be overridden at runtime from inside the app (stored as
# `api_base_url` in localStorage, e.g. from Settings), without rebuilding,
# for users who need to point an already-installed copy at a different
# backend — see frontend-web/src/lib/api.ts's desktopApiUrlOverride.
VITE_API_URL=http://localhost:8082/api

# Identifies this build as the desktop client (vs. the web build) to any
# shared frontend-web/src code that needs to branch on it.
VITE_APP_TARGET=desktop
